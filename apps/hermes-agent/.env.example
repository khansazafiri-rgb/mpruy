# MEDCOEL API
MEDCOEL_API_BASE_URL=https://medcoel.com
MEDCOEL_AGENT_IDENTITY=hermes
MEDCOEL_AGENT_PASSWORD=change-me

# Telegram bot created with @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-me
# Comma-separated Telegram numeric user IDs allowed to control Hermes.
TELEGRAM_ADMIN_IDS=123456789

# Google Drive read access for queue PDF relay.
# Prefer credentials scoped to the MEDCOEL source folder when possible.
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=

# Worker settings
HERMES_QUEUE_POLL_MS=15000
HERMES_TELEGRAM_LONG_POLL_SECONDS=25
HERMES_STATE_DIR=./data
HERMES_MAX_JSON_BYTES=5242880

# Notifikasi pengajuan yang masih Menunggu konfirmasi (sebelum Antre). Bawaan: true.
HERMES_NOTIFY_WAITING=true
# Saat pertama menyala, umumkan pengajuan yang berubah dalam sekian jam terakhir.
HERMES_WAITING_LOOKBACK_HOURS=72
# Lama sesi tempel JSON beberapa pesan sebelum kedaluwarsa (menit).
HERMES_PASTE_TTL_MINUTES=30
