 "sent_text": {
  "s1": "SpO₂ bisa terlihat normal, tapi Hb ternyata rendah.",
  "s2": "Kok bisa?",
  "s3": "Dua angka ini mengukur hal yang berbeda.",
  "s4": "SpO₂ memperkirakan persentase hemoglobin yang sedang membawa oksigen.",
  "s5": "Tes Hb mengukur banyaknya hemoglobin di dalam darah.",
  "s6": "Hemoglobin adalah protein dalam sel darah merah yang membawa oksigen ke jaringan.",
  "s7": "Pada tes Hb cepat tertentu, satu tetes darah dari ujung jari masuk ke wadah kecil bernama mikrokuvet.",
  "s8": "Salurannya sangat sempit, sehingga darah tertarik masuk oleh gaya kapiler.",
  "s9": "Di dalam mikrokuvet contoh alat ini sudah ada reagen.",
  "s10": "Reagen pertama memecah sel darah merah dan melepaskan hemoglobinnya.",
  "s11": "Reagen berikutnya mengubah hemoglobin menjadi bentuk yang dapat diukur dengan cahaya.",
  "s12": "Mikrokuvet lalu dimasukkan ke alat.",
  "s13": "Cahaya melewati sampel, dan sensor membaca berapa banyak cahaya yang diserap.",
  "s14": "Alat memakai dua panjang gelombang.",
  "s15": "Salah satunya membantu mengoreksi gangguan karena sampel keruh.",
  "s16": "Hasilnya dihitung dan ditampilkan sebagai kadar Hb, biasanya dalam gram per desiliter.",
  "s17": "Tes ini membantu menilai kemungkinan anemia atau memantau perubahannya.",
  "s18": "Tapi satu angka Hb belum memberi tahu penyebabnya.",
  "s19": "Sampel dari ujung jari juga bisa menghasilkan hasil yang kurang tepat bila pengambilannya bermasalah.",
  "s20": "Kalau angka tidak cocok dengan gejala, pemeriksaan lanjutan mungkin diperlukan.",
  "s21": "Jadi, SpO₂ menunjukkan proporsi hemoglobin yang membawa oksigen,",
  "s22": "tes Hb menunjukkan berapa banyak hemoglobin yang tersedia."
 },
