{
"fps": 30,
"lead": 0.6,
"audioDur": 55.56,
"total": 58.96,
"caps": [
{
"text": "Kamu udah hafal semua soal kakak tingkat.",
"a0": 0.29,
"a1": 2.78
},
{
"text": "Tapi pas ujian dimulai…",
"a0": 3.04,
"a1": 4.65
},
{
"text": "kok soalnya beda semua?!",
"a0": 5.37,
"a1": 7.01
},
{
"text": "Tenang, masih ada",
"a0": 7.11,
"a1": 8.66
},
{
"text": "MEDCOEL buat bantu kamu belajar",
"a0": 8.66,
"a1": 9.575
},
{
"text": "sebelum ujian!",
"a0": 9.575,
"a1": 11.26
},
{
"text": "Malam sebelumnya,",
"a0": 12.1,
"a1": 13.01
},
{
"text": "kamu begitu percaya diri.",
"a0": 13.01,
"a1": 14.32
},
{
"text": "Soal nomor satu jawabannya A.",
"a0": 14.48,
"a1": 16.48
},
{
"text": "Nomor dua, C.",
"a0": 16.68,
"a1": 17.91
},
{
"text": "Nomor tiga…",
"a0": 18.09,
"a1": 18.86
},
{
"text": "hafal di luar kepala!",
"a0": 19.0,
"a1": 20.36
},
{
"text": "Tapi besoknya,",
"a0": 20.81,
"a1": 22.09
},
{
"text": "begitu lembar ujian dibuka…",
"a0": 22.09,
"a1": 23.61
},
{
"text": "Loh?! Ini materi yang mana?!",
"a0": 24.46,
"a1": 26.01
},
{
"text": "Kamu ingat jawabannya,",
"a0": 27.18,
"a1": 28.83
},
{
"text": "tapi ternyata belum benar-benar",
"a0": 28.83,
"a1": 30.405
},
{
"text": "paham konsepnya.",
"a0": 30.405,
"a1": 31.2
},
{
"text": "Biar persiapanmu lebih mantap,",
"a0": 31.93,
"a1": 33.55
},
{
"text": "kamu bisa mulai dari",
"a0": 33.55,
"a1": 34.64
},
{
"text": "catatan materi di MEDCOEL.",
"a0": 34.64,
"a1": 36.29
},
{
"text": "Setelah itu, coba uji pemahamanmu",
"a0": 36.63,
"a1": 38.885
},
{
"text": "lewat latihan soal",
"a0": 38.885,
"a1": 40.11
},
{
"text": "dan pelajari pembahasannya.",
"a0": 40.11,
"a1": 41.26
},
{
"text": "Masih ada yang lupa?",
"a0": 41.74,
"a1": 42.56
},
{
"text": "Ulangi lagi pakai flashcard!",
"a0": 42.81,
"a1": 44.66
},
{
"text": "Jadi, kamu bisa belajar konsepnya,",
"a0": 45.04,
"a1": 47.33
},
{
"text": "lalu latihan",
"a0": 47.51,
"a1": 48.54
},
{
"text": "menghadapi berbagai pertanyaan.",
"a0": 48.54,
"a1": 49.97
},
{
"text": "Yuk, siapin ujianmu",
"a0": 50.26,
"a1": 51.87
},
{
"text": "bareng MEDCOEL.",
"a0": 51.87,
"a1": 52.34
},
{
"text": "Belajar kedokteran gratis",
"a0": 52.55,
"a1": 54.29
},
{
"text": "di medcoel.com!",
"a0": 54.29,
"a1": 55.24
}
],
