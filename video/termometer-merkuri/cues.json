 "sent_text": {
  "s1": "Pernah lihat termometer air raksa?",
  "s2": "Setelah dilepas dari tubuh, garis peraknya tetap berhenti di angka tadi.",
  "s3": "Kok bisa?",
  "s4": "Pertama, air raksa itu sebenarnya merkuri.",
  "s5": "Logam yang cair pada suhu ruang.",
  "s6": "Di ujung termometer, ada wadah kecil berisi merkuri.",
  "s7": "Tersambung ke saluran kaca yang sangat sempit.",
  "s8": "Ketika ujungnya menerima panas dari tubuh, merkuri memuai.",
  "s9": "Volumennya bertambah dan mendorong garis perak naik di saluran sempit itu.",
  "s10": "Semakin tinggi suhu, semakin jauh garisnya bergerak.",
  "s11": "Angka pada kaca menunjukkan suhu berdasarkan posisi ujung garis tersebut.",
  "s12": "Tapi ada satu bagian kecil yang penting.",
  "s13": "Penyempitan saluran tepat di atas wadah merkuri.",
  "s14": "Saat termometer dilepas dan mulai dingin, bagian ini menahan kolom merkuri agar tidak langsung turun.",
  "s15": "Jadi kita masih bisa membaca suhu tertinggi yang tercapai.",
  "s16": "Itulah alasan termometer jenis ini perlu diatur ulang sebelum pengukuran berikutnya.",
  "s17": "Lalu kenapa sekarang lebih sering terlihat termometer digital?",
  "s18": "Kalau kaca termometer merkuri pecah, merkurinya bisa tersebar dan uapnya berbahaya.",
  "s19": "Karena itu, banyak layanan kesehatan beralih ke alat tanpa merkuri.",
  "s20": "Jadi garis perak yang tampak sederhana itu bekerja karena pemuayan, saluran sempit, dan penyempitan kecil yang menahan hasilnya."
 },
