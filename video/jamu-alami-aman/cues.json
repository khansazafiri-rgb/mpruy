 "sent_text": {
  "s1": "Kalau jamu berasal dari tanaman, berarti pasti aman dan pasti manjur.",
  "s2": "Tunggu dulu, jamu bukan satu jenis obat dengan satu cara kerja.",
  "s3": "Setiap ramuan bisa mengandung banyak senyawa.",
  "s4": "Setelah diminum, sebagian senyawa melewati saluran cerna, diserap,",
  "s5": "diproses oleh tubuh, lalu mungkin memengaruhi proses biologis tertentu.",
  "s6": "Tetapi senyawa dan efeknya berbeda untuk setiap bahan.",
  "s7": "Contohnya jahe.",
  "s8": "Ada penelitian yang menunjukkan jahe mungkin membantu mual pada kehamilan.",
  "s9": "Tapi itu tidak berarti setiap jamu jahe terbukti mengatasi semua jenis mual,",
  "s10": "apalagi semua penyakit.",
  "s11": "Di Indonesia, tingkat pembuktiannya juga berbeda.",
  "s12": "Jamu didasarkan pada penggunaan empiris.",
  "s13": "Obat herbal terstandar sudah didukung uji praklinik dan standardisasi bahan.",
  "s14": "Fitofarmaka memiliki bukti uji klinik pada manusia.",
  "s15": "Dan alami bukan berarti bebas risiko.",
  "s16": "Bahan herbal bisa menimbulkan efek samping atau berinteraksi dengan obat yang sedang diminum.",
  "s17": "BPOM juga pernah menemukan produk jamu ilegal yang diam-diam dicampur bahan kimia obat.",
  "s18": "Jadi sebelum mengonsumsi produk, cek izin edar, komposisi, aturan pakai, dan klaimnya.",
  "s19": "Kalau sedang hamil, punya penyakit tertentu, atau rutin minum obat,",
  "s20": "tanyakan dulu kepada tenaga kesehatan.",
  "s21": "Jamu juga tidak boleh menggantikan pengobatan yang memang kamu perlukan."
 },
