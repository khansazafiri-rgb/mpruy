[
  {
    "start": 0,
    "end": 2.6,
    "lines": [
      "BELUM MAKAN, TAPI KOK",
      "PERUT MALAH PERIH?"
    ]
  },
  {
    "start": 3.94,
    "end": 5.2,
    "lines": [
      "SAAT LAMBUNG KOSONG,"
    ]
  },
  {
    "start": 5.3,
    "end": 7.52,
    "lines": [
      "IA TIDAK MENDADAK BERHENTI",
      "MENGHASILKAN ASAM."
    ]
  },
  {
    "start": 7.8,
    "end": 9.72,
    "lines": [
      "NAMUN, DINDING LAMBUNG",
      "PUNYA PELINDUNG,"
    ]
  },
  {
    "start": 9.98,
    "end": 11.72,
    "lines": [
      "LAPISAN LENDIR",
      "DAN BIKARBONAT."
    ]
  },
  {
    "start": 12.32,
    "end": 13.3,
    "lines": [
      "PADA SEBAGIAN ORANG,"
    ]
  },
  {
    "start": 13.62,
    "end": 15.2,
    "lines": [
      "SENSASI DARI LAMBUNG",
      "BISA TERASA LEBIH"
    ]
  },
  {
    "start": 15.2,
    "end": 16.6,
    "lines": [
      "MENGGANGGU",
      "KETIKA PERUT KOSONG."
    ]
  },
  {
    "start": 17.06,
    "end": 19.76,
    "lines": [
      "RASA PERIH INI BELUM BERARTI",
      "DINDING LAMBUNGNYA LUKA."
    ]
  },
  {
    "start": 20.64,
    "end": 22.86,
    "lines": [
      "LALU, KAPAN BISA JADI",
      "MASALAH YANG BERBEDA?"
    ]
  },
  {
    "start": 23.84,
    "end": 25.2,
    "lines": [
      "INFEKSI H. PYLORI"
    ]
  },
  {
    "start": 25.2,
    "end": 27.5,
    "lines": [
      "ATAU PENGGUNAAN OBAT",
      "ANTIINFLAMASI TERTENTU"
    ]
  },
  {
    "start": 27.5,
    "end": 29.5,
    "lines": [
      "DAPAT MENGGANGGU PERTAHANAN",
      "DINDING LAMBUNG."
    ]
  },
  {
    "start": 31.6,
    "end": 33.8,
    "lines": [
      "JIKA TERBENTUK LUKA,",
      "ITULAH TUKAK."
    ]
  },
  {
    "start": 34.02,
    "end": 35.0,
    "lines": [
      "PADA SEBAGIAN ORANG,"
    ]
  },
  {
    "start": 35.22,
    "end": 36.82,
    "lines": [
      "NYERINYA TERASA",
      "SAAT LAMBUNG KOSONG."
    ]
  },
  {
    "start": 37.86,
    "end": 39.98,
    "lines": [
      "OBATNYA PUN BEKERJA",
      "DENGAN CARA BERBEDA."
    ]
  },
  {
    "start": 40.42,
    "end": 42.66,
    "lines": [
      "ANTASIDA MENETRALKAN",
      "ASAM YANG SUDAH ADA."
    ]
  },
  {
    "start": 44.3,
    "end": 45.8,
    "lines": [
      "OBAT PENGHAMBAT",
      "POMPA PROTON"
    ]
  },
  {
    "start": 45.8,
    "end": 47.5,
    "lines": [
      "MENGURANGI ASAM",
      "YANG DIPRODUKSI."
    ]
  },
  {
    "start": 49.5,
    "end": 50.9,
    "lines": [
      "KALAU PENYEBABNYA H. PYLORI,"
    ]
  },
  {
    "start": 51.3,
    "end": 53.55,
    "lines": [
      "PENGOBATANNYA PERLU",
      "MENANGANI BAKTERINYA JUGA."
    ]
  },
  {
    "start": 54.48,
    "end": 56.95,
    "lines": [
      "JADI, KELUHAN YANG SERING",
      "KITA SEBUT MAAG,"
    ]
  },
  {
    "start": 57.12,
    "end": 59.2,
    "lines": [
      "TIDAK SELALU PUNYA PENYEBAB",
      "ATAU OBAT YANG SAMA."
    ]
  },
  {
    "start": 59.64,
    "end": 60.98,
    "lines": [
      "KALAU PERIHNYA BERULANG,"
    ]
  },
  {
    "start": 61.2,
    "end": 62.4,
    "lines": [
      "MAKIN BERAT ATAU DISERTAI"
    ]
  },
  {
    "start": 62.4,
    "end": 63.9,
    "lines": [
      "MUNTAH DARAH",
      "MAUPUN TINJA HITAM,"
    ]
  },
  {
    "start": 64.06,
    "end": 65.46,
    "lines": [
      "PERIKSAKAN DIRI."
    ]
  },
  {
    "start": 65.48,
    "end": 67.35,
    "lines": [
      "MAU MEMAHAMI MEKANISME TUBUH",
      "LEBIH JAUH?"
    ]
  },
  {
    "start": 67.7,
    "end": 69.2,
    "lines": [
      "DI MEDCOEL, KAMU BISA BELAJAR"
    ]
  },
  {
    "start": 69.2,
    "end": 69.98,
    "lines": [
      "MATERI PER BAB,"
    ]
  },
  {
    "start": 74.2,
    "end": 75.06,
    "lines": [
      "LATIHAN SOAL,"
    ]
  },
  {
    "start": 79.96,
    "end": 81.22,
    "lines": [
      "DAN MENCOBA SIMULASI DOKTER."
    ]
  },
  {
    "start": 84.6,
    "end": 86.66,
    "lines": [
      "BELAJAR FK GRATIS",
      "DI MEDCOEL.COM."
    ]
  }
]
