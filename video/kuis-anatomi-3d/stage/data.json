{
"fps": 30,
"lead": 0.6,
"audioDur": 49.633,
"total": 53.033,
"caps": [
{
"text": "Semalaman menghafalin atlas anatomi.",
"a0": 0.07,
"a1": 2.5
},
{
"text": "Tapi begitu berdiri di depan kadaver,",
"a0": 2.81,
"a1": 5.02
},
{
"text": "semua nama yang kamu hafal",
"a0": 5.15,
"a1": 6.75
},
{
"text": "mendadak menghilang.",
"a0": 6.75,
"a1": 7.82
},
{
"text": "Coba uji ingatanmu di kuis anatomi 3D MEDCOEL.",
"a0": 8.16,
"a1": 11.235
},
{
"text": "Pilih bagian tubuh,",
"a0": 11.235,
"a1": 12.535
},
{
"text": "pilih sistemnya,",
"a0": 12.535,
"a1": 13.625
},
{
"text": "lalu tentukan cara kamu mau latihan.",
"a0": 13.625,
"a1": 15.29
},
{
"text": "Di mode Kenali Struktur,",
"a0": 15.29,
"a1": 17.265
},
{
"text": "satu bagian akan disorot pada model 3D.",
"a0": 17.265,
"a1": 19.75
},
{
"text": "Tugasmu: pilih nama yang benar.",
"a0": 19.75,
"a1": 21.8
},
{
"text": "Mau tantangan sebaliknya?",
"a0": 21.95,
"a1": 23.245
},
{
"text": "Di mode Temukan di 3D,",
"a0": 23.245,
"a1": 24.825
},
{
"text": "namanya sudah diberikan.",
"a0": 24.825,
"a1": 26.32
},
{
"text": "Sekarang, cari dan klik strukturnya",
"a0": 26.32,
"a1": 28.105
},
{
"text": "langsung pada model.",
"a0": 28.105,
"a1": 29.655
},
{
"text": "Kamu juga bisa menebak sistem",
"a0": 29.655,
"a1": 30.995
},
{
"text": "dan regio dari struktur yang ditampilkan.",
"a0": 30.995,
"a1": 33.41
},
{
"text": "Salah jawab, tenang!",
"a0": 33.41,
"a1": 35.305
},
{
"text": "Jawaban yang benar akan ditampilkan,",
"a0": 35.305,
"a1": 37.85
},
{
"text": "jadi kamu bisa belajar",
"a0": 37.85,
"a1": 38.78
},
{
"text": "dan lanjut ke soal berikutnya.",
"a0": 38.78,
"a1": 41.39
},
{
"text": "Sebelum bilang \"aku udah hafal\",",
"a0": 41.39,
"a1": 43.325
},
{
"text": "coba buktikan dulu di sini.",
"a0": 43.325,
"a1": 44.53
},
{
"text": "Latihan anatomi gratis di MEDCOEL.",
"a0": 44.53,
"a1": 47.495
},
{
"text": "Buka medcoel.com dan mulai kuisnya.",
"a0": 47.495,
"a1": 49.54
}
],
