{
"fps": 30,
"lead": 0.6,
"audioDur": 89.887,
"total": 93.287,
"caps": [
{
"text": "Kamu dibawa ke IGD dalam keadaan tidak sadar.",
"a0": 0.06,
"a1": 2.8
},
{
"text": "Dokter harus menunggu keluargamu datang dulu?",
"a0": 3.18,
"a1": 5.35
},
{
"text": "Bayangkan,",
"a0": 5.59,
"a1": 6.37
},
{
"text": "kamu baru saja mengalami kecelakaan.",
"a0": 6.62,
"a1": 8.75
},
{
"text": "Kamu dibawa ke rumah sakit,",
"a0": 9.11,
"a1": 10.46
},
{
"text": "tapi kamu tidak bisa menjawab pertanyaan dokter.",
"a0": 10.82,
"a1": 13.35
},
{
"text": "Kondisimu gawat.",
"a0": 13.75,
"a1": 14.86
},
{
"text": "Dokter harus segera melakukan tindakan.",
"a0": 15.21,
"a1": 17.26
},
{
"text": "Masalahnya,",
"a0": 17.59,
"a1": 18.46
},
{
"text": "kamu tidak sadar,",
"a0": 18.67,
"a1": 19.8
},
{
"text": "dan keluargamu belum bisa dihubungi.",
"a0": 19.8,
"a1": 21.93
},
{
"text": "Padahal, bukannya tindakan medis harus mendapat persetujuan pasien?",
"a0": 22.1,
"a1": 25.87
},
{
"text": "Benar!",
"a0": 25.87,
"a1": 26.58
},
{
"text": "Secara umum, sebelum melakukan tindakan,",
"a0": 26.93,
"a1": 29.42
},
{
"text": "tenaga medis perlu memberikan penjelasan",
"a0": 29.42,
"a1": 31.8
},
{
"text": "dan mendapatkan persetujuan.",
"a0": 31.8,
"a1": 33.59
},
{
"text": "Tapi bagaimana kalau pasiennya tidak mampu memberikan persetujuan,",
"a0": 33.72,
"a1": 36.98
},
{
"text": "sementara waktu terus berjalan?",
"a0": 36.98,
"a1": 39.42
},
{
"text": "Dalam keadaan tertentu,",
"a0": 39.56,
"a1": 41.03
},
{
"text": "hukum di Indonesia memberikan pengecualian.",
"a0": 41.03,
"a1": 43.59
},
{
"text": "Menurut Undang-Undang Kesehatan,",
"a0": 43.92,
"a1": 45.92
},
{
"text": "jika pasien tidak cakap,",
"a0": 45.92,
"a1": 47.21
},
{
"text": "membutuhkan tindakan gawat darurat",
"a0": 47.41,
"a1": 49.21
},
{
"text": "dan tidak ada orang yang bisa dimintai persetujuan,",
"a0": 49.36,
"a1": 52.17
},
{
"text": "tindakan dapat dilakukan tanpa menunggu persetujuan.",
"a0": 52.4,
"a1": 55.22
},
{
"text": "Keputusan itu tetap harus diambil",
"a0": 55.22,
"a1": 57.83
},
{
"text": "berdasarkan kepentingan terbaik pasien.",
"a0": 57.83,
"a1": 60.08
},
{
"text": "Setelahnya, tindakan yang dilakukan",
"a0": 60.41,
"a1": 62.3
},
{
"text": "harus diinformasikan kepada pasien",
"a0": 62.3,
"a1": 64.61
},
{
"text": "saat ia sudah cakap,",
"a0": 64.61,
"a1": 65.99
},
{
"text": "atau kepada pihak yang mewakilinya ketika mereka hadir.",
"a0": 66.16,
"a1": 69.47
},
{
"text": "Jadi, persetujuan pasien tetap penting.",
"a0": 69.47,
"a1": 72.31
},
{
"text": "Namun, dalam situasi gawat darurat dengan kondisi tadi,",
"a0": 72.31,
"a1": 75.75
},
{
"text": "dokter dapat bertindak ketika pasien tidak mampu memutuskan",
"a0": 75.75,
"a1": 79.59
},
{
"text": "dan tidak ada wakil yang bisa dimintai persetujuan.",
"a0": 79.59,
"a1": 82.58
},
{
"text": "Penasaran dengan fakta lain",
"a0": 82.77,
"a1": 83.65
},
{
"text": "tentang dunia kedokteran?",
"a0": 83.65,
"a1": 85.33
},
{
"text": "Belajar kedokteran gratis di MEDCOEL,",
"a0": 85.33,
"a1": 87.92
},
{
"text": "lewat medcoel.com.",
"a0": 88.07,
"a1": 89.84
}
],
