{
"fps": 30,
"lead": 0.6,
"audioDur": 75.468,
"total": 78.868,
"caps": [
{
"text": "Kerokan bisa menyembuhkan masuk angin?",
"a0": 0.08,
"a1": 2.32
},
{
"text": "Terus, kenapa bekasnya merah?",
"a0": 2.69,
"a1": 4.44
},
{
"text": "Kamu mungkin pernah merasa badan",
"a0": 4.84,
"a1": 6.49
},
{
"text": "lebih enak setelah dikerok.",
"a0": 6.49,
"a1": 7.85
},
{
"text": "Tapi apakah warna merah itu",
"a0": 8.2,
"a1": 10.0
},
{
"text": "tanda anginnya keluar?",
"a0": 10.0,
"a1": 11.42
},
{
"text": "Yuk, kita intip apa yang terjadi di kulitmu!",
"a0": 11.66,
"a1": 14.15
},
{
"text": "Saat kulit digesek,",
"a0": 14.54,
"a1": 15.795
},
{
"text": "muncul respons pada jaringan",
"a0": 15.795,
"a1": 17.695
},
{
"text": "dan pembuluh darah kecil di bawahnya.",
"a0": 17.695,
"a1": 19.43
},
{
"text": "Gesekan dan tekanan itu",
"a0": 19.76,
"a1": 21.32
},
{
"text": "bisa membuat kulit terlihat merah,",
"a0": 21.32,
"a1": 23.25
},
{
"text": "bahkan meninggalkan bekas seperti memar.",
"a0": 23.39,
"a1": 25.74
},
{
"text": "Jadi, warna merahnya bukan ukuran",
"a0": 25.97,
"a1": 27.825
},
{
"text": "berapa banyak angin yang keluar dari tubuhmu.",
"a0": 27.825,
"a1": 30.62
},
{
"text": "Lalu, kenapa setelah",
"a0": 30.84,
"a1": 32.245
},
{
"text": "kerokan ada orang yang merasa lebih nyaman?",
"a0": 32.245,
"a1": 34.4
},
{
"text": "Rasa nyaman yang dialami",
"a0": 34.71,
"a1": 36.565
},
{
"text": "seseorang bisa berbeda-beda.",
"a0": 36.565,
"a1": 37.72
},
{
"text": "Tapi, rasa lebih enak setelah",
"a0": 37.96,
"a1": 39.805
},
{
"text": "kerokan belum cukup untuk memastikan",
"a0": 39.805,
"a1": 41.95
},
{
"text": "penyebab keluhannya sudah teratasi.",
"a0": 41.95,
"a1": 44.27
},
{
"text": "Soalnya, masuk angin adalah",
"a0": 44.55,
"a1": 46.525
},
{
"text": "istilah yang biasa digunakan",
"a0": 46.525,
"a1": 47.97
},
{
"text": "untuk berbagai keluhan,",
"a0": 47.97,
"a1": 49.42
},
{
"text": "seperti badan pegal,",
"a0": 49.53,
"a1": 50.835
},
{
"text": "kembung,",
"a0": 50.835,
"a1": 51.545
},
{
"text": "atau merasa nggak enak badan.",
"a0": 51.545,
"a1": 53.2
},
{
"text": "Keluhan yang terlihat mirip",
"a0": 53.47,
"a1": 55.17
},
{
"text": "bisa punya penyebab yang berbeda.",
"a0": 55.17,
"a1": 56.62
},
{
"text": "Jadi...",
"a0": 56.82,
"a1": 57.51
},
{
"text": "Kalau keluhanmu menetap,",
"a0": 57.63,
"a1": 58.93
},
{
"text": "makin berat,",
"a0": 59.1,
"a1": 59.88
},
{
"text": "atau disertai gejala yang mengkhawatirkan,",
"a0": 60.09,
"a1": 62.25
},
{
"text": "periksakan diri ke tenaga kesehatan.",
"a0": 62.38,
"a1": 64.32
},
{
"text": "Kesimpulannya,",
"a0": 64.55,
"a1": 65.48
},
{
"text": "Punggung yang semakin merah bukan berarti",
"a0": 65.63,
"a1": 67.725
},
{
"text": "angin yang keluar semakin banyak.",
"a0": 67.725,
"a1": 69.73
},
{
"text": "Penasaran dengan cara kerja tubuh lainnya?",
"a0": 69.97,
"a1": 71.88
},
{
"text": "Belajar bareng MEDCOEL,",
"a0": 71.98,
"a1": 73.955
},
{
"text": "gratis di medcoel.com.",
"a0": 73.955,
"a1": 75.41
}
],
