{
"fps": 30,
"lead": 0.6,
"audioDur": 84.271,
"total": 87.671,
"caps": [
{
"text": "Kenapa sih,",
"a0": 0.16,
"a1": 0.92
},
{
"text": "Kalau kedinginan,",
"a0": 1.16,
"a1": 2.065
},
{
"text": "kamu jadi lebih sering pengen pipis.",
"a0": 2.065,
"a1": 3.88
},
{
"text": "Baru masuk kelas ber-AC.",
"a0": 3.88,
"a1": 5.885
},
{
"text": "Belum juga dosennya selesai menjelaskan,",
"a0": 5.885,
"a1": 8.135
},
{
"text": "kamu udah mulai mencari toilet.",
"a0": 8.135,
"a1": 9.96
},
{
"text": "Tapi apa hubungannya udara dingin",
"a0": 10.2,
"a1": 12.66
},
{
"text": "sama keinginan buat pipis?",
"a0": 12.66,
"a1": 13.94
},
{
"text": "Yuk, kita intip apa yang terjadi",
"a0": 13.94,
"a1": 15.645
},
{
"text": "di dalam tubuhmu!",
"a0": 15.645,
"a1": 16.94
},
{
"text": "Saat kamu kedinginan,",
"a0": 17.63,
"a1": 18.99
},
{
"text": "tubuhmu berusaha menjaga panas",
"a0": 18.99,
"a1": 20.915
},
{
"text": "supaya nggak terlalu banyak keluar.",
"a0": 20.915,
"a1": 22.71
},
{
"text": "Salah satu caranya adalah dengan",
"a0": 23.04,
"a1": 25.075
},
{
"text": "menyempitkan pembuluh darah",
"a0": 25.075,
"a1": 26.175
},
{
"text": "di dekat permukaan kulit.",
"a0": 26.175,
"a1": 27.5
},
{
"text": "Tapi saat pembuluh darah ini menyempit,",
"a0": 27.74,
"a1": 30.03
},
{
"text": "ke mana darahnya pergi?",
"a0": 30.23,
"a1": 31.46
},
{
"text": "Lebih banyak darah bergeser",
"a0": 31.7,
"a1": 33.26
},
{
"text": "ke bagian tengah tubuh,",
"a0": 33.26,
"a1": 34.51
},
{
"text": "dan tekanan darah bisa meningkat.",
"a0": 34.7,
"a1": 36.65
},
{
"text": "Nah, perubahan ini juga",
"a0": 36.82,
"a1": 38.685
},
{
"text": "bisa memengaruhi ginjalmu.",
"a0": 38.685,
"a1": 40.47
},
{
"text": "Ginjal membantu mengatur",
"a0": 40.61,
"a1": 42.135
},
{
"text": "cairan dan garam dalam tubuh.",
"a0": 42.135,
"a1": 43.87
},
{
"text": "Dalam kondisi tertentu,",
"a0": 44.11,
"a1": 45.505
},
{
"text": "respons tubuh terhadap dingin",
"a0": 45.505,
"a1": 47.27
},
{
"text": "dapat membuat ginjal mengeluarkan",
"a0": 47.27,
"a1": 48.85
},
{
"text": "lebih banyak cairan sebagai urine.",
"a0": 48.85,
"a1": 51.11
},
{
"text": "Fenomena ini disebut",
"a0": 51.24,
"a1": 52.415
},
{
"text": "diuresis akibat dingin.",
"a0": 52.415,
"a1": 54.165
},
{
"text": "Jadi saat kamu sibuk memeluk jaket di kelas,",
"a0": 54.165,
"a1": 57.585
},
{
"text": "ginjalmu juga sedang sibuk",
"a0": 57.585,
"a1": 59.2
},
{
"text": "menyesuaikan diri.",
"a0": 59.2,
"a1": 60.65
},
{
"text": "Tapi tunggu.",
"a0": 60.84,
"a1": 61.5
},
{
"text": "Rasa ingin pipis saat dingin",
"a0": 61.67,
"a1": 64.095
},
{
"text": "nggak selalu disebabkan oleh proses ini ya.",
"a0": 64.095,
"a1": 65.535
},
{
"text": "Berapa banyak kamu minum,",
"a0": 65.535,
"a1": 67.095
},
{
"text": "seberapa dingin ruangannya,",
"a0": 67.095,
"a1": 68.78
},
{
"text": "dan kondisi kandung kemihmu",
"a0": 68.78,
"a1": 70.375
},
{
"text": "juga bisa berpengaruh.",
"a0": 70.375,
"a1": 71.61
},
{
"text": "Kalau kamu sering pipis",
"a0": 71.88,
"a1": 73.185
},
{
"text": "bahkan saat nggak kedinginan,",
"a0": 73.185,
"a1": 74.79
},
{
"text": "apalagi disertai nyeri,",
"a0": 74.79,
"a1": 76.1
},
{
"text": "jangan langsung menyalahkan AC.",
"a0": 76.1,
"a1": 78.14
},
{
"text": "Penasaran dengan cara kerja tubuh lainnya?",
"a0": 78.29,
"a1": 80.25
},
{
"text": "Yuk, belajar bareng MEDCOEL",
"a0": 80.25,
"a1": 82.1
},
{
"text": "gratis di medcoel.com.",
"a0": 82.1,
"a1": 84.17
}
],
