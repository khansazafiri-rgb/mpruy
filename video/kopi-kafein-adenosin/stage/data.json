{
"fps": 30,
"lead": 0.6,
"audioDur": 88.529,
"total": 91.929,
"caps": [
{
"text": "Kenapa sih,",
"a0": 0.08,
"a1": 0.85
},
{
"text": "setelah minum kopi,",
"a0": 1.06,
"a1": 2.31
},
{
"text": "kita bisa merasa nggak ngantuk?",
"a0": 2.31,
"a1": 4.06
},
{
"text": "Apa yang sebenarnya terjadi di dalam tubuhmu?",
"a0": 4.35,
"a1": 6.97
},
{
"text": "Saat kamu terjaga,",
"a0": 7.44,
"a1": 8.79
},
{
"text": "ada zat di otakmu yang disebut adenosin.",
"a0": 8.79,
"a1": 11.69
},
{
"text": "Salah satu perannya adalah",
"a0": 12.09,
"a1": 13.5
},
{
"text": "membantu membangun dorongan untuk tidur.",
"a0": 13.5,
"a1": 15.93
},
{
"text": "Semakin lama kamu terjaga,",
"a0": 16.27,
"a1": 17.925
},
{
"text": "tekanan untuk tidur biasanya semakin besar.",
"a0": 17.925,
"a1": 20.59
},
{
"text": "Itulah salah satu alasan kenapa matamu",
"a0": 20.93,
"a1": 23.225
},
{
"text": "terasa berat setelah seharian beraktivitas.",
"a0": 23.225,
"a1": 25.9
},
{
"text": "Lalu kamu minum kopi.",
"a0": 26.19,
"a1": 27.96
},
{
"text": "Kafein di dalam kopi diserap",
"a0": 28.27,
"a1": 30.38
},
{
"text": "melalui saluran pencernaan,",
"a0": 30.38,
"a1": 31.77
},
{
"text": "masuk ke aliran darah,",
"a0": 31.77,
"a1": 33.19
},
{
"text": "dan terbawa sampai ke otak.",
"a0": 33.19,
"a1": 35.0
},
{
"text": "Di sana, kafein menempel pada reseptor adenosin",
"a0": 35.4,
"a1": 38.64
},
{
"text": "dan menghalangi adenosin",
"a0": 38.64,
"a1": 40.165
},
{
"text": "bekerja pada reseptor tersebut.",
"a0": 40.165,
"a1": 41.82
},
{
"text": "Akibatnya, salah satu sinyal",
"a0": 42.14,
"a1": 44.05
},
{
"text": "yang mendorong rasa kantuk jadi berkurang.",
"a0": 44.05,
"a1": 46.33
},
{
"text": "Itulah kenapa kamu bisa merasa lebih terjaga",
"a0": 46.6,
"a1": 49.155
},
{
"text": "setelah minum kopi.",
"a0": 49.155,
"a1": 50.55
},
{
"text": "Tapi apakah itu berarti",
"a0": 50.9,
"a1": 52.415
},
{
"text": "tubuhmu sudah tidak butuh tidur?",
"a0": 52.415,
"a1": 54.32
},
{
"text": "Jawabannya? Nggak.",
"a0": 54.61,
"a1": 56.22
},
{
"text": "Kafein bisa membantumu",
"a0": 56.5,
"a1": 57.835
},
{
"text": "tetap waspada untuk sementara.",
"a0": 57.835,
"a1": 59.93
},
{
"text": "Tapi tidak menggantikan tidur.",
"a0": 60.15,
"a1": 62.13
},
{
"text": "Dalam sebuah penelitian terhadap 276 peserta,",
"a0": 62.39,
"a1": 65.43
},
{
"text": "kafein membantu mengurangi gangguan perhatian",
"a0": 65.43,
"a1": 68.5
},
{
"text": "akibat kurang tidur.",
"a0": 68.5,
"a1": 69.74
},
{
"text": "Namun, kafein tidak memperbaiki",
"a0": 70.02,
"a1": 72.085
},
{
"text": "semua jenis kemampuan yang diuji.",
"a0": 72.085,
"a1": 74.24
},
{
"text": "Jadi, meskipun setelah minum kopi",
"a0": 74.52,
"a1": 76.71
},
{
"text": "kamu merasa siap menyelesaikan semua tugas malam ini,",
"a0": 76.71,
"a1": 79.89
},
{
"text": "tubuhmu tetap butuh istirahat.",
"a0": 79.89,
"a1": 82.22
},
{
"text": "Penasaran bagaimana tubuhmu bekerja?",
"a0": 82.6,
"a1": 84.58
},
{
"text": "Belajar bareng MEDCOEL,",
"a0": 84.8,
"a1": 86.485
},
{
"text": "gratis di medcoel.com.",
"a0": 86.485,
"a1": 88.41
}
],
