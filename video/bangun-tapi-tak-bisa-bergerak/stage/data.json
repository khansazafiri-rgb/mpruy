  {
   "text": "Tapi apa yang sebenarnya terjadi?",
   "t0": 25.09,
   "t1": 27.29
  },
  {
   "text": "Saat kita bermimpi dalam fase tidur REM,",
   "t0": 27.74,
   "t1": 30.21
  },
  {
   "text": "gerak otot tubuh untuk sementara ditahan.",
   "t0": 30.21,
   "t1": 32.9
  },
  {
   "text": "Kadang kesadaran muncul lebih dulu,",
   "t0": 33.12,
   "t1": 35.39
  },
  {
   "text": "sementara tubuh belum sepenuhnya",
   "t0": 35.5,
   "t1": 37.37
