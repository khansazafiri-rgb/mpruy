  {
   "text": "tetapi belum bisa bergerak atau bicara.",
   "t0": 40.96,
   "t1": 43.33
  },
  {
   "text": "Pengalaman ini disebut sleep paralysis,",
   "t0": 43.52,
   "t1": 46.05
  },
  {
   "text": "atau kelumpuhan tidur.",
   "t0": 46.05,
   "t1": 47.81
  },
  {
   "text": "Pada sebagian orang, sensasi mirip mimpi masih terbawa,",
   "t0": 48.04,
   "t1": 51.7
  },
  {
   "text": "sehingga kamar terasa jauh lebih menyeramkan",
   "t0": 51.7,
   "t1": 54.35
  },
  {
   "text": "daripada biasanya.",
   "t0": 54.35,
   "t1": 55.74
  },
  {
   "text": "Episode seperti ini umumnya singkat.",
   "t0": 55.97,
   "t1": 58.24
  },
  {
   "text": "Jadi, bagian paling menakutkan dari kamar tadi",
   "t0": 58.38,
   "t1": 61.35
  },
  {
   "text": "bukan bayangannya,",
   "t0": 61.35,
   "t1": 62.65
  },
  {
   "text": "tapi beberapa detik ketika kamu",
