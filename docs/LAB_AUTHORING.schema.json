{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medcoel.com/schemas/lab-authoring-v1.json",
  "title": "MEDCOEL Lab authoring bundle V1",
  "type": "object",
  "required": ["schemaVersion", "records"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "records": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/record" } }
  },
  "$defs": {
    "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,99}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 6000 },
    "keys": { "type": "array", "items": { "$ref": "#/$defs/key" }, "uniqueItems": true },
    "record": {
      "type": "object", "required": ["kind", "data"], "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["source", "guide", "catalog", "module", "placement"] },
        "op": { "const": "upsert" },
        "data": { "type": "object", "required": ["key"], "properties": { "key": { "$ref": "#/$defs/key" }, "title": { "$ref": "#/$defs/text" } } }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "source" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/source" } } } },
        { "if": { "properties": { "kind": { "const": "guide" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/guide" } } } },
        { "if": { "properties": { "kind": { "const": "catalog" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/catalog" } } } },
        { "if": { "properties": { "kind": { "const": "module" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/module" } } } },
        { "if": { "properties": { "kind": { "const": "placement" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/placement" } } } }
      ]
    },
    "license": { "type": "object", "required": ["name", "url", "verified", "commercialUse", "redistribution"], "properties": { "name": { "$ref": "#/$defs/text" }, "url": { "type": "string", "format": "uri", "pattern": "^https://" }, "citation": { "type": "string" }, "verified": { "type": "boolean" }, "commercialUse": { "type": "boolean" }, "redistribution": { "type": "boolean" }, "attributionRequired": { "type": "boolean" } } },
    "source": { "type": "object", "required": ["key", "title", "role", "url", "license"], "properties": { "key": { "$ref": "#/$defs/key" }, "title": { "$ref": "#/$defs/text" }, "role": { "enum": ["asset", "reference"] }, "ingestionAllowed": { "type": "boolean" }, "datasetReviewRequired": { "type": "boolean" }, "url": { "type": "string", "format": "uri", "pattern": "^https://" }, "citation": { "type": "string" }, "license": { "$ref": "#/$defs/license" }, "policies": { "type": "array", "items": { "type": "object", "required": ["collection", "allowed"], "properties": { "collection": { "$ref": "#/$defs/key" }, "allowed": { "type": "boolean" }, "reviewed": { "type": "boolean" }, "note": { "type": "string" } } } }, "disclosure": { "type": "string" } } },
    "guide": { "type": "object", "required": ["key", "title", "subject", "scope", "steps"], "properties": { "key": { "$ref": "#/$defs/key" }, "title": { "$ref": "#/$defs/text" }, "subject": { "$ref": "#/$defs/text" }, "scope": { "enum": ["module", "chapter", "section"] }, "steps": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["title", "text"], "properties": { "title": { "$ref": "#/$defs/text" }, "text": { "$ref": "#/$defs/text" } } } }, "sources": { "$ref": "#/$defs/keys" } } },
    "catalog": { "type": "object", "required": ["key", "title"], "properties": { "key": { "$ref": "#/$defs/key" }, "title": { "$ref": "#/$defs/text" }, "parent": { "$ref": "#/$defs/key" }, "summary": { "type": "string" }, "order": { "type": "integer" } } },
    "placement": { "type": "object", "required": ["key", "title", "module", "catalog"], "properties": { "key": { "$ref": "#/$defs/key" }, "title": { "$ref": "#/$defs/text" }, "module": { "$ref": "#/$defs/key" }, "catalog": { "$ref": "#/$defs/key" }, "order": { "type": "integer" } } },
    "module": { "type": "object", "required": ["key"], "properties": { "key": { "$ref": "#/$defs/key" }, "title": { "$ref": "#/$defs/text" }, "summary": { "type": "string" }, "sources": { "$ref": "#/$defs/keys" }, "chapters": { "type": "array", "items": { "$ref": "#/$defs/chapter" } }, "questionBanks": { "type": "array", "items": { "$ref": "#/$defs/bank" } }, "pathways": { "type": "array", "items": { "$ref": "#/$defs/pathway" } } } },
    "chapter": { "type": "object", "required": ["key"], "properties": { "key": { "$ref": "#/$defs/key" }, "title": { "$ref": "#/$defs/text" }, "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } } } },
    "section": { "type": "object", "required": ["key"], "properties": { "key": { "$ref": "#/$defs/key" }, "title": { "$ref": "#/$defs/text" }, "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } } } },
    "block": { "type": "object", "required": ["key", "type"], "properties": { "key": { "$ref": "#/$defs/key" }, "type": { "enum": ["text", "image", "gallery", "compare", "identification_guide", "identification_table", "callout", "source_disclosure", "practice"] }, "title": { "type": "string" }, "text": { "type": "string" }, "tone": { "enum": ["info", "tip", "warn"] }, "asset": { "$ref": "#/$defs/key" }, "assets": { "$ref": "#/$defs/keys" }, "left": { "$ref": "#/$defs/key" }, "right": { "$ref": "#/$defs/key" }, "guide": { "$ref": "#/$defs/key" }, "sources": { "$ref": "#/$defs/keys" }, "columns": { "type": "array", "items": { "type": "string" } }, "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }, "bank": { "$ref": "#/$defs/key" } } },
    "bank": { "type": "object", "required": ["key"], "properties": { "key": { "$ref": "#/$defs/key" }, "title": { "$ref": "#/$defs/text" }, "questions": { "type": "array", "items": { "$ref": "#/$defs/question" } } } },
    "question": { "type": "object", "required": ["key", "type", "prompt", "options", "answer"], "properties": { "key": { "$ref": "#/$defs/key" }, "type": { "enum": ["single_best_answer", "image_identification"] }, "prompt": { "$ref": "#/$defs/text" }, "options": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["label", "text"], "properties": { "label": { "type": "string" }, "text": { "$ref": "#/$defs/text" } } } }, "answer": { "type": "string" }, "explanation": { "type": "string" }, "asset": { "$ref": "#/$defs/key" }, "sources": { "$ref": "#/$defs/keys" }, "tags": { "type": "array", "items": { "type": "string" } }, "difficulty": { "enum": ["intro", "intermediate", "advanced"] } } },
    "pathway": { "type": "object", "required": ["key", "title", "sections"], "properties": { "key": { "$ref": "#/$defs/key" }, "title": { "$ref": "#/$defs/text" }, "sections": { "$ref": "#/$defs/keys" } } }
  }
}
