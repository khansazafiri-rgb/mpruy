  "pneumoniamnist": {
    "schemaVersion": 1,
    "dataset": "PneumoniaMNIST",
    "scope": "class",
    "title": "Cara Membaca Pola Dasar",
    "introduction": {
      "text": "Mulai dengan kualitas dan aerasi citra, lalu bandingkan opasitas. Ini latihan interpretasi gambar, bukan pemeriksaan klinis lengkap.",
      "sources": [
        "who-cres",
        "acr"
      ]
    },
    "comparison": {
      "title": "Normal vs Pneumonia",
      "columns": [
        "Normal",
        "Pneumonia / opasitas abnormal"
      ],
      "rows": [
        {
          "key": "cxr-0",
          "label": "Lapang paru",
          "values": [
            {
              "text": "Relatif teraerasi; cari ketiadaan opasitas fokal yang jelas.",
              "sources": [
                "who-2005",
                "who-cres"
              ]
            },
            {
              "text": "Dapat terdapat peningkatan opasitas dengan distribusi yang bervariasi.",
              "sources": [
                "who-2005",
                "who-cres"
              ]
            }
          ]
        },
        {
          "key": "cxr-1",
          "label": "Konsolidasi",
          "values": [
            {
              "text": "Tidak dicari sebagai temuan normal; periksa adanya opasitas air-space yang jelas.",
              "sources": [
                "who-2005",
                "who-cres"
              ]
            },
            {
              "text": "Dapat berupa opasitas padat atau saling menyatu; bukan ciri wajib setiap citra.",
              "sources": [
                "who-2005",
                "who-cres"
              ]
            }
          ]
        },
        {
          "key": "cxr-2",
          "label": "Air bronchogram",
          "values": [
            {
              "text": "Bukan temuan abnormal yang diharapkan pada paru teraerasi tanpa konsolidasi.",
              "sources": [
                "who-2005",
                "who-cres"
              ]
            },
            {
              "text": "Bronkus berisi udara dapat tampak di dalam daerah konsolidasi.",
              "sources": [
                "who-2005",
                "who-cres"
              ]
            }
          ]
        },
        {
          "key": "cxr-3",
          "label": "Infiltrat lain",
          "values": [
            {
              "text": "Cari ketiadaan pola infiltrat patologis yang jelas.",
              "sources": [
                "who-2005",
                "who-cres"
              ]
            },
            {
              "text": "Dapat berupa opasitas linier atau bercak; istilah ini tidak menentukan penyebab.",
              "sources": [
                "who-2005",
                "who-cres"
              ]
            }
          ]
        },
        {
          "key": "cxr-4",
          "label": "Efusi pleura",
          "values": [
            {
              "text": "Cari ketiadaan cairan pleura yang jelas.",
              "sources": [
                "who-2005",
                "who-cres"
              ]
            },
            {
              "text": "Dapat berupa cairan di ruang pleura lateral; hanya pada sebagian kasus.",
              "sources": [
                "who-2005",
                "who-cres"
              ]
            }
          ]
        }
      ]
    },
    "profiles": [
      {
        "key": "normal",
        "title": "Normal",
        "features": [
          {
            "text": "Cari lapang paru yang relatif teraerasi, tanpa opasitas air-space fokal yang jelas.",
            "sources": [
              "who-cres"
            ]
          },
          {
            "text": "Periksa apakah ada konsolidasi, infiltrat lain, atau efusi yang jelas.",
            "sources": [
              "who-cres"
            ]
          },
          {
            "text": "Label Normal bukan jaminan tidak adanya semua kelainan atau temuan insidental.",
            "sources": [
              "medmnist",
              "cxr-review"
            ]
          }
        ],
        "compare": [],
        "caveats": []
      },
      {
        "key": "pneumonia",
        "title": "Pneumonia",
        "features": [
          {
            "text": "Cari area opasitas yang meningkat; distribusinya dapat fokal atau berupa bercak.",
            "sources": [
              "who-2005",
              "cxr-review"
            ]
          },
          {
            "text": "Konsolidasi dan air bronchogram dapat terlihat pada sebagian gambar.",
            "sources": [
              "who-2005"
            ]
          },
          {
            "text": "Pola infiltrat dapat bervariasi; efusi mungkin menyertai sebagian kasus dan bukan syarat semua citra.",
            "sources": [
              "who-cres"
            ]
          }
        ],
        "compare": [],
        "caveats": [
          {
            "text": "Tidak semua gambar berlabel Pneumonia menunjukkan semua ciri di atas.",
            "sources": [
              "medmnist"
            ]
          }
        ]
      }
    ],
    "checklist": [
      {
        "text": "Bagaimana kualitas citra dan aerasi kedua lapang paru?",
        "sources": [
          "who-2005",
          "who-cres"
        ]
      },
      {
        "text": "Adakah area opasitas yang meningkat?",
        "sources": [
          "who-2005",
          "who-cres"
        ]
      },
      {
        "text": "Apakah pola opasitas tampak fokal, bercak, atau lebih menyebar?",
        "sources": [
          "who-2005",
          "who-cres"
        ]
      },
      {
        "text": "Adakah pola konsolidasi?",
        "sources": [
          "who-2005",
          "who-cres"
        ]
      },
      {
        "text": "Adakah kemungkinan air bronchogram di dalam opasitas?",
        "sources": [
          "who-2005",
          "who-cres"
        ]
      },
      {
        "text": "Adakah tanda cairan pleura yang perlu diperhatikan?",
        "sources": [
          "who-2005",
          "who-cres"
        ]
      }
    ],
    "notes": [
      {
