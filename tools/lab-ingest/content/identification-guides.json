{
  "bloodmnist": {
    "schemaVersion": 1,
    "dataset": "BloodMNIST",
    "title": "Cara Identifikasi",
    "scope": "class",
    "introduction": {
      "text": "Ciri umum untuk membandingkan kelompok sel; tidak semua ciri harus terlihat pada setiap crop. Pengenalan jenis sel tidak menetapkan diagnosis pasien.",
      "sources": [
        "medmnist"
      ]
    },
    "comparison": {
      "title": "Bandingkan ciri sel",
      "columns": [
        "Nukleus",
        "Sitoplasma / granula",
        "Kunci identifikasi"
      ],
      "rows": [
        {
          "key": "neutrophil",
          "label": "Neutrofil",
          "values": [
            {
              "text": "Nukleus matang bersegmen; lobus dihubungkan jembatan tipis.",
              "sources": [
                "ash-neutrophil",
                "mcgill"
              ]
            },
            {
              "text": "Sitoplasma pucat dengan granula halus.",
              "sources": [
                "ash-neutrophil",
                "mcgill"
              ]
            },
            {
              "text": "Cari gabungan segmentasi nukleus dan granula yang tidak terlalu mencolok.",
              "sources": [
                "ash-neutrophil",
                "mcgill"
              ]
            }
          ]
        },
        {
          "key": "eosinophil",
          "label": "Eosinofil",
          "values": [
            {
              "text": "Nukleus umumnya bilobus, tetapi bentuknya dapat bervariasi.",
              "sources": [
                "ash-eosinophil"
              ]
            },
            {
              "text": "Granula kasar merah-oranye banyak mengisi sitoplasma.",
              "sources": [
                "ash-eosinophil"
              ]
            },
            {
              "text": "Gabungkan warna dan ukuran granula dengan bentuk nukleus; jangan memakai satu ciri saja.",
              "sources": [
                "ash-eosinophil"
              ]
            }
          ]
        },
        {
          "key": "basophil",
          "label": "Basofil",
          "values": [
            {
              "text": "Kontur nukleus dapat tersamar oleh granula.",
              "sources": [
                "ash-basophil"
              ]
            },
            {
              "text": "Granula besar dan gelap berwarna biru-ungu.",
              "sources": [
                "ash-basophil"
              ]
            },
            {
              "text": "Granula kasar yang menutupi sebagian nukleus menjadi petunjuk penting.",
              "sources": [
                "ash-basophil"
              ]
            }
          ]
        },
        {
          "key": "immature granulocytes",
          "label": "Granulosit imatur",
          "values": [
            {
              "text": "Bentuk nukleus dan kepadatan kromatin berubah menurut maturasi.",
              "sources": [
                "ash-promyelocyte",
                "ash-myelocyte",
                "ash-metamyelocyte"
              ]
            },
            {
              "text": "Jenis dan jumlah granula bervariasi menurut tahap maturasi.",
              "sources": [
                "ash-promyelocyte",
                "ash-myelocyte",
                "ash-metamyelocyte"
              ]
            },
            {
              "text": "Kenali sebagai kelompok granulosit yang belum matang; tidak ada satu pola morfologi tunggal.",
              "sources": [
                "ash-promyelocyte",
                "ash-myelocyte",
                "ash-metamyelocyte"
              ]
            }
          ]
        },
        {
          "key": "lymphocyte",
          "label": "Limfosit",
          "values": [
            {
              "text": "Nukleus umumnya bulat dengan kromatin padat; pada limfosit kecil, nukleus mendominasi sel.",
              "sources": [
                "ash-lymphocyte",
                "mcgill"
              ]
            },
            {
              "text": "Sitoplasma relatif sedikit, berupa tepi biru pucat pada limfosit kecil yang istirahat.",
              "sources": [
                "ash-lymphocyte"
              ]
            },
            {
              "text": "Cari dominasi nukleus padat dan tepi sitoplasma yang tipis; bentuk limfosit dapat bervariasi.",
              "sources": [
                "ash-lymphocyte"
              ]
            }
          ]
        },
        {
          "key": "monocyte",
          "label": "Monosit",
          "values": [
            {
              "text": "Nukleus tidak teratur, berlekuk atau menyerupai ginjal; kromatin relatif lebih halus.",
              "sources": [
                "ash-monocyte"
              ]
            },
            {
              "text": "Sitoplasma luas berwarna abu-biru; vakuola dapat terlihat.",
              "sources": [
                "ash-monocyte"
              ]
            },
            {
              "text": "Gabungkan ukuran sel relatif besar, lekukan nukleus, dan sitoplasma yang luas.",
              "sources": [
                "ash-monocyte"
              ]
            }
          ]
        },
        {
          "key": "erythroblast",
          "label": "Eritroblas",
          "values": [
            {
              "text": "Prekursor eritroid berinti; kromatin makin padat selama maturasi.",
              "sources": [
                "ash-erythroid"
              ]
            },
            {
              "text": "Warna sitoplasma berubah dari biru menuju abu-merah muda seiring bertambahnya hemoglobin.",
              "sources": [
                "ash-erythroid"
              ]
            },
            {
              "text": "Ukuran sel dan rasio nukleus:sitoplasma umumnya berkurang selama maturasi; nilai ciri sebagai rangkaian.",
              "sources": [
                "ash-erythroid"
              ]
            }
          ]
        },
        {
          "key": "platelet",
          "label": "Trombosit",
          "values": [
            {
              "text": "Tidak memiliki nukleus.",
              "sources": [
                "ash-platelet"
              ]
            },
            {
              "text": "Fragmen sitoplasma sangat kecil dengan granula ungu dan bagian sitoplasma biru pucat.",
              "sources": [
                "ash-platelet"
              ]
            },
            {
              "text": "Cari fragmen kecil tanpa inti; jangan menyimpulkan ukuran absolut dari pembesaran crop gambar.",
              "sources": [
                "ash-platelet"
              ]
            }
          ]
        }
      ]
    },
    "profiles": [
      {
        "key": "neutrophil",
        "title": "Neutrofil",
        "features": [
          {
            "text": "Nukleus matang bersegmen; lobus dihubungkan jembatan tipis.",
