# Variabel lingkungan server MEDCOEL. Salin ke /opt/medcoel/medcoel.env:
#   sudo cp deploy/medcoel.env.example /opt/medcoel/medcoel.env
#   sudo chmod 600 /opt/medcoel/medcoel.env && sudo chown medcoel /opt/medcoel/medcoel.env
# File ini TIDAK PERNAH dicommit.

# 32 karakter acak, untuk mengenkripsi password di pendaftaran sementara.
# Buat dengan: openssl rand -hex 16
MEDCOEL_SECRET=

# Bantuan draf pembahasan Inggris (opsional, lihat docs/PEMBAHASAN_INGGRIS.md).
# Tanpa dua nilai ini, penulisan dan pemeriksaan manual tetap tersedia.
# Pilih model yang mendukung Responses API + Structured Outputs di akunmu.
OPENAI_API_KEY=
MEDCOEL_TRANSLATION_MODEL=

# Google Drive admin (lihat docs/GOOGLE_DRIVE.md)
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
GDRIVE_ROOT_FOLDER_ID=

# Cloudflare Turnstile (captcha gratis): https://dash.cloudflare.com > Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Hermes Agent (lihat docs/HERMES_AGENT.md)
# Alamat IP server AI yang boleh memakai akun agen, dipisah koma. Kosong = tidak dibatasi IP.
MEDCOEL_AGENT_IPS=
# Opsional: web memberi tahu Hermes saat ada pengajuan masuk antrean.
HERMES_WEBHOOK_URL=
HERMES_WEBHOOK_SECRET=

# JANGAN diisi di produksi. Hanya untuk laptop: kode email dikembalikan di respons.
# MEDCOEL_DEV_MODE=1
