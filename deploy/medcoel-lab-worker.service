[Unit]
Description=MEDCOEL Lab durable asset worker
After=network-online.target pocketbase.service
Wants=network-online.target
Requires=pocketbase.service

[Service]
Type=simple
User=MEDCOEL
Group=MEDCOEL
WorkingDirectory=/opt/medcoel
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=MEDCOEL_API_BASE=http://127.0.0.1:8090
Environment=MEDCOEL_LAB_CACHE=/opt/medcoel/tools/lab-ingest/cache
EnvironmentFile=/etc/medcoel/lab-worker.env
ExecStart=/opt/medcoel-ai/.venv/bin/python /opt/medcoel/tools/lab-ingest/lab_worker.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
MemoryMax=1G
CPUQuota=70%
Nice=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/medcoel/tools/lab-ingest/cache
PrivateTmp=true

[Install]
WantedBy=multi-user.target
