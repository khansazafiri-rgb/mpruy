[Unit]
Description=MEDCOEL Hermes Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=medcoel-hermes
Group=medcoel-hermes
WorkingDirectory=/opt/medcoel-hermes/app/apps/hermes-agent
EnvironmentFile=/opt/medcoel-hermes/hermes.env
ExecStart=/usr/bin/node /opt/medcoel-hermes/app/apps/hermes-agent/src/index.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/medcoel-hermes/data
UMask=0077

[Install]
WantedBy=multi-user.target
