{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medcoel.com/schemas/studios/catalog.v1.json",
  "title": "MEDCOEL Clinical Studios catalog v1",
  "description": "Contract: docs/clinical-studios/05-contract-specification.md. A valid entry is never enough to launch a studio: availability is resolved server-side and fails closed.",
  "type": "object",
  "required": ["schemaVersion", "catalogVersion", "studios"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogVersion": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "note": { "type": "string" },
    "studios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/studio" } }
  },
  "$defs": {
    "capability": {
      "enum": ["anatomy3d", "structure-identification", "slice-navigation", "mpr", "window-level", "measurement", "ultrasound-probe", "clinical-case", "fixture-echo"]
    },
    "modeState": { "enum": ["planned", "building", "available", "none"] },
    "reviewState": { "enum": ["pending", "approved", "not-required"] },
    "studio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "title", "titleId", "region", "modality", "runtime", "capabilities", "plannedCapabilities", "learningModes", "datasets", "reuses", "access", "review", "licensing", "release", "blockers"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,40}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "titleId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "region": { "enum": ["brain", "headNeck", "spine", "thorax", "heart", "abdomen", "pelvis", "upperLimb", "lowerLimb", "internal"] },
        "modality": { "enum": ["anatomy3d", "ct", "mri", "xray", "ultrasound", "ecg", "none"] },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "entry", "releaseId"],
          "properties": {
            "type": { "enum": ["iframe", "module"] },
            "entry": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._/-]{0,120}$" },
            "releaseId": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" }
          }
        },
        "capabilities": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/capability" } },
        "plannedCapabilities": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/capability" } },
        "learningModes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["guided", "challenge", "typedQuiz"],
          "properties": { "guided": { "$ref": "#/$defs/modeState" }, "challenge": { "$ref": "#/$defs/modeState" }, "typedQuiz": { "$ref": "#/$defs/modeState" } }
        },
        "datasets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "provenance", "licence", "protected"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,48}$" },
              "kind": { "enum": ["mesh", "ct-volume", "mri-series", "xray-image", "ultrasound-scenario", "terminology", "test-content"] },
              "provenance": { "type": "string", "minLength": 1 },
              "licence": { "enum": ["verified", "unverified", "restricted"] },
              "protected": { "type": "boolean" }
            }
          }
        },
        "reuses": { "type": ["string", "null"] },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": ["roles", "campuses"],
          "properties": {
            "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["user", "admin"] } },
            "campuses": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["clinical", "anatomical"],
          "properties": {
            "clinical": { "$ref": "#/$defs/reviewState" },
            "anatomical": { "$ref": "#/$defs/reviewState" },
            "approvedBy": { "type": "string" },
            "approvedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          }
        },
        "licensing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "ref"],
          "properties": { "status": { "enum": ["verified", "unverified", "blocked"] }, "ref": { "type": ["string", "null"] } }
        },
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": { "status": { "enum": ["planned", "building", "review", "publishable"] } }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "reason"],
            "properties": { "kind": { "enum": ["licence", "clinical", "data", "technical"] }, "reason": { "type": "string", "minLength": 1, "maxLength": 300 } }
          }
        },
        "internal": { "const": true }
      }
    }
  }
}
